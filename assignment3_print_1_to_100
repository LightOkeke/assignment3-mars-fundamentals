.data
space: .asciiz " "
newline: .asciiz "\n"

.text
.globl main

main:
    li $t0, 1          # current number
    li $t1, 100        # ending number

print_loop:
    li $v0, 1          # syscall 1 = print integer
    move $a0, $t0
    syscall

    li $v0, 4          # syscall 4 = print string
    la $a0, space
    syscall

    addi $t0, $t0, 1   # current number++
    ble $t0, $t1, print_loop

    li $v0, 4
    la $a0, newline
    syscall

    li $v0, 10         # exit
    syscall
    
  